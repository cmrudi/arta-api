PORT=3000
AWS_REGION=ap-southeast-1
ORDERS_TABLE_NAME=Orders
ORDER_DATE_ATTRIBUTE=orderDate

# Xplori physical SIM provider (POST {XPLORI_API_URL} with header "Authorization: Api-Key {XPLORI_API_KEY}")
XPLORI_API_URL=https://services.xplori.world/api/order/package/
XPLORI_API_KEY=

# Brevo transactional email (internal order confirmation)
BREVO_API_KEY=

# Partner payouts (see README "Partner Payouts")
PARTNER_MIN_WITHDRAWAL=500000
BREVO_PARTNER_PAYOUT_TEMPLATE_ID=
PARTNER_PAYOUT_OPS_EMAIL=
PARTNER_PORTAL_URL=https://partner.artamobile.id
